# Local Postgres from docker-compose.yml. Not a production secret.
DATABASE_URL=postgresql://ftv:ftv@localhost:5432/ftv

# Provider-agnostic football data. "stub" performs no network I/O.
# Paid providers (API-Football Pro, Sportmonks, and others) are optional future adapters.
FOOTBALL_API_PROVIDER=stub
FOOTBALL_API_KEY=

# Free ClubElo daily CSV base. The client appends /YYYY-MM-DD when a live adapter exists.
# Fetch stays off in CI and by default. This stub does not call the network.
CLUBELO_BASE_URL=http://api.clubelo.com
CLUBELO_FETCH_ENABLED=false

# Service ports and the dashboard's view of the prediction API.
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
